# Raw WhatsApp exports — contain private group conversations, do not commit
exports/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Generated CSVs / spreadsheets (regenerate from DB)
data/*.csv
data/*.xlsx
data/~$*

# OS
.DS_Store

# HK DB is committed xz-compressed (data/watches.db.xz); the app unpacks it.
data/watches.db
data/*.unpacking
data/*.xz.tmp

# local tooling
.claude/
